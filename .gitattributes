# 仓库内统一用 LF 存储，检出时按平台转换
* text=auto

# Windows 专用文件必须是 CRLF，否则 cmd 解析 .bat 会出错
*.bat         text eol=crlf
*.cmd         text eol=crlf
*.sln         text eol=crlf
*.slnx        text eol=crlf
*.vcxproj     text eol=crlf
*.vcxproj.*   text eol=crlf

# 二进制文件不做行尾转换
*.png  binary
*.jpg  binary
*.ico  binary
